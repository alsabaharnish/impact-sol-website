# Public canonical origin. Required for a production build.
IMPACT_SOL_SITE_URL=https://www.example.com

# Monitored direct contact shown on the website.
PUBLIC_CONTACT_EMAIL=arnish@lamppost.org.bd

# Form service configuration. Keep all values server-side.
INQUIRY_DATABASE_PATH=./runtime-data/inquiries.sqlite
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
RESEND_API_KEY=
INQUIRY_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8788
INQUIRY_IP_HASH_SECRET=replace-with-a-long-random-secret
INQUIRY_RETENTION_DAYS=90
INQUIRY_MAX_BODY_BYTES=32768
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=900
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_DELIVERY_INTERVAL_MS=15000
INQUIRY_MAX_DELIVERY_ATTEMPTS=8
HOST=127.0.0.1
PORT=8788
TRUST_PROXY=false
MAINTENANCE_MODE=false
