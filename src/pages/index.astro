---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import SystemMap from '../components/SystemMap.astro';
import ChokroFlow from '../components/ChokroFlow.astro';
import { siteConfig } from '../data/site';
import { getProduct } from '../content/read';

const chokro = await getProduct('chokro');
if (!chokro) throw new Error('The required Chokro product record is missing.');
const chokroStage = chokro.stage === 'working-prototype' ? 'Working prototype' : chokro.stage;

const audiences = [
  {
    number: '01',
    title: 'Makers and small sellers',
    text: 'People building thoughtful products who need practical routes to stronger digital operations, visibility, and growth.',
    href: '/get-involved/#makers',
    action: 'Tell us about your work',
  },
  {
    number: '02',
    title: 'Initiatives and social enterprises',
    text: 'Purpose-led teams exploring useful technology, delivery support, learning, or a collaborative project.',
    href: '/get-involved/#initiatives',
    action: 'Discuss an initiative',
  },
  {
    number: '03',
    title: 'Institutions and ecosystem partners',
    text: 'Companies, funders, public bodies, and civil-society organisations looking for a grounded partnership pathway.',
    href: '/get-involved/#institutions',
    action: 'Propose a partnership',
  },
];

const capabilities = [
  {
    title: 'Build impact products',
    text: 'Shape practical digital products around real environmental and social problems—not technology for its own sake.',
  },
  {
    title: 'Enable eco-conscious enterprise',
    text: 'Explore appropriate support for digital operations, product design, learning, and responsible routes to market.',
  },
  {
    title: 'Develop partnerships',
    text: 'Bring together the roles, resources, and delivery relationships a useful initiative may need.',
  },
  {
    title: 'Measure and improve',
    text: 'Define evidence before making claims, state limitations clearly, and use what is learned to make the work stronger.',
  },
];

const pathways = [
  { label: 'For makers', href: '/get-involved/#makers', action: 'Share what you are building' },
  { label: 'For initiatives', href: '/get-involved/#initiatives', action: 'Explore project support' },
  { label: 'For institutions', href: '/get-involved/#institutions', action: 'Shape a partnership' },
  { label: 'For contributors', href: '/get-involved/#contributors', action: 'Offer skills or perspective' },
];
---

<BaseLayout
  title={siteConfig.name}
  description="Impact Sol. is being established to build practical products, support eco-conscious enterprise, and develop responsible partnerships."
>
  <section class="home-hero">
    <div class="shell home-hero__inner">
      <div class="home-hero__copy">
        <p class="status-chip"><span aria-hidden="true"></span>Proposed company · Being established</p>
        <h1>Technology and collaboration for a greener, more inclusive economy.</h1>
        <p class="lead">
          Impact Sol. is building products and partnerships intended to help eco-conscious makers, small sellers, and sustainability initiatives grow through practical technology, shared resources, and responsible innovation.
        </p>
        <div class="button-row">
          <a class="button" href="/what-we-do/" data-event="primary_cta" data-placement="home_hero">See what we plan to do</a>
          <a class="text-link" href="/products/chokro/" data-event="product_click" data-placement="home_hero">Explore the Chokro prototype <span aria-hidden="true">→</span></a>
        </div>
        <p class="home-hero__note">
          We are at an early stage. Public claims, partnerships, and product availability will be published only when they can be evidenced.
        </p>
      </div>
      <SystemMap />
    </div>
  </section>

  <aside class="stage-band" aria-label="Current stage">
    <div class="shell stage-band__inner">
      <p><strong>Current stage</strong> Impact Sol. is a proposed parent business with its identity and operating model still being established.</p>
      <a href="/about/#current-stage">See what that means <span aria-hidden="true">→</span></a>
    </div>
  </aside>

  <section class="section" aria-labelledby="support-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Who we intend to support</p>
          <h2 id="support-title">Different roles. One shared direction.</h2>
        </div>
        <p>
          Useful ecosystems make room for people closest to the problem and for organisations able to remove barriers. Each pathway starts with a clear need, not a preset solution.
        </p>
      </div>
      <div class="grid grid--3 audience-grid">
        {audiences.map((audience) => (
          <article class="audience-card">
            <span class="audience-card__number" aria-hidden="true">{audience.number}</span>
            <h3>{audience.title}</h3>
            <p>{audience.text}</p>
            <a class="text-link" href={audience.href} data-event="pathway_click" data-placement="home_audiences">
              {audience.action} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section principle-section" aria-labelledby="principle-title">
    <div class="shell principle-section__inner">
      <div>
        <p class="eyebrow eyebrow--light">Why Impact Sol.</p>
        <h2 id="principle-title">Good intent becomes useful when it fits real life.</h2>
      </div>
      <div class="principle-section__copy">
        <p class="lead">
          Responsible enterprises and initiatives often navigate fragmented tools, limited capacity, and difficult routes to the right collaborators. Impact Sol. is being designed to help close those practical gaps.
        </p>
        <p>
          “Sol” is short for solutions. It also reflects the energy created when people, ideas, and technology come together around a shared purpose. New technology belongs here only when it solves a real problem, strengthens trust, or extends positive impact.
        </p>
        <a class="text-link text-link--light" href="/about/">Read our provisional mission and principles <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="work-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="work-title">Four ways to move from purpose to practice.</h2>
        </div>
        <div>
          <p>These are intended capability areas, not a claim that every service is available today. Scope, capacity, and commercial model are confirmed before any engagement.</p>
          <a class="text-link" href="/what-we-do/">See capabilities and boundaries <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ol class="capability-grid">
        {capabilities.map((capability, index) => (
          <li>
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{capability.title}</h3>
            <p>{capability.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section product-feature" aria-labelledby="chokro-title">
    <div class="shell product-feature__inner">
      <div class="product-feature__copy">
        <div class="product-feature__brand">
          <img src="/assets/brand/chokro-app-icon.svg" width="54" height="54" alt="" />
          <div><span>Proposed product relationship</span><strong>{chokro.name}</strong></div>
        </div>
        <p class="eyebrow">Featured prototype</p>
        <h2 id="chokro-title">Make responsible action visible—and connect it to a wider cycle.</h2>
        <p class="lead">
          {chokro.tagline} It is designed around responsible disposal, reviewed eco-actions, internal rewards, and a marketplace pathway for small eco-conscious sellers.
        </p>
        <p>
          <strong>{chokroStage}.</strong> Android, iOS, and web code exists. Public availability, production app links, and browser QR entry still require release verification. {chokro.ownershipNote}
        </p>
        <div class="button-row">
          <a class="button button--sun" href="/products/chokro/" data-event="product_click" data-placement="home_feature">Explore how Chokro works</a>
          <a class="text-link text-link--light" href="/get-involved/#chokro-interest" data-event="pathway_click" data-placement="home_feature">Register interest <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ChokroFlow />
    </div>
  </section>

  <section class="section section--mint" aria-labelledby="collaboration-title">
    <div class="shell collaboration-grid">
      <div class="collaboration-grid__intro">
        <p class="eyebrow">How collaboration works</p>
        <h2 id="collaboration-title">Start with the need. Keep learning in the loop.</h2>
        <p>Every possible engagement should make roles, outputs, safeguards, limitations, and decisions clear before work begins.</p>
        <a class="button button--secondary" href="/get-involved/">Choose a collaboration pathway</a>
      </div>
      <ol class="steps">
        <li><h3>Understand the need</h3><p>Listen to the people involved and define the problem, context, constraints, and desired change.</p></li>
        <li><h3>Co-design the response</h3><p>Agree what is useful, what is feasible, who owns which decisions, and how risk will be handled.</p></li>
        <li><h3>Build and implement</h3><p>Create or adapt the right product, capability, or partnership with appropriate checks along the way.</p></li>
        <li><h3>Measure and improve</h3><p>Use proportionate evidence, publish limitations, learn from the result, and adjust the work.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="impact-title">
    <div class="shell impact-grid">
      <div>
        <p class="eyebrow">Purpose and approach</p>
        <h2 id="impact-title">Claims should follow evidence—not ambition.</h2>
        <p class="lead">
          The launch framework separates intended change, product activity, and verified outcomes. No organisation-level impact results are claimed yet.
        </p>
        <a class="button button--secondary" href="/impact/">Read the measurement approach</a>
      </div>
      <div class="impact-principles" aria-label="Measurement principles">
        <article><span>Define</span><h3>Name what is being measured</h3><p>State the indicator, unit, period, scope, owner, and method.</p></article>
        <article><span>Separate</span><h3>Do not turn signals into outcomes</h3><p>Keep activities, outputs, outcomes, and long-term intentions distinct.</p></article>
        <article><span>Disclose</span><h3>Make limits part of the story</h3><p>Say what the evidence can and cannot support, and when it was last reviewed.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="pathways-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Find your route</p>
          <h2 id="pathways-title">What would you like to move forward?</h2>
        </div>
        <p>Choose the closest starting point. A focused form helps your message reach the right review queue without collecting more information than needed.</p>
      </div>
      <div class="pathway-list">
        {pathways.map((pathway, index) => (
          <a href={pathway.href} data-event="pathway_click" data-placement="home_pathways">
            <span aria-hidden="true">0{index + 1}</span>
            <strong>{pathway.label}</strong>
            <em>{pathway.action}</em>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Begin a conversation"
    title="Bring a real need, an open question, or a useful perspective."
    text="Impact Sol. is still being established, so the best conversations are specific about the people involved, the problem, and what a responsible next step could look like."
    href="/get-involved/"
    label="Work with us"
    secondaryHref="/contact/"
    secondaryLabel="Send a general inquiry"
  />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: clip;
    padding: clamp(3rem, 6.5vw, 6.75rem) 0 clamp(4rem, 7.5vw, 7.5rem);
    background:
      radial-gradient(circle at 88% 6%, rgb(242 180 65 / 15%), transparent 25rem),
      linear-gradient(145deg, var(--color-paper) 55%, var(--color-mint-soft));
  }

  .home-hero::before {
    position: absolute;
    top: -11rem;
    left: -13rem;
    width: 28rem;
    height: 28rem;
    border: 1px solid rgb(18 60 52 / 9%);
    border-radius: 50%;
    content: '';
  }

  .home-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(22rem, 0.88fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 6rem);
  }

  .status-chip {
    width: fit-content;
    gap: 0.5rem;
  }

  .status-chip span {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-sun-deep);
    border-radius: 50%;
  }

  h1 {
    max-width: 12.5ch;
    margin: var(--space-4) 0 0;
    font-size: var(--step-6);
    letter-spacing: -0.06em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .home-hero .lead {
    max-width: 42rem;
    margin-top: var(--space-5);
  }

  .home-hero__note {
    max-width: 37rem;
    margin: var(--space-5) 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-sun-deep);
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .stage-band {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .stage-band__inner {
    display: flex;
    min-height: 5.5rem;
    padding-block: 0.85rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .stage-band p {
    margin: 0;
    color: var(--color-paper-muted);
    font-size: 0.9rem;
  }

  .stage-band strong {
    margin-right: 0.7rem;
    color: var(--color-mint);
  }

  .stage-band a {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-paper);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .audience-grid {
    align-items: stretch;
  }

  .audience-card {
    display: flex;
    min-height: 24rem;
    padding: clamp(1.4rem, 2.8vw, 2.25rem);
    flex-direction: column;
    border-top: 1px solid var(--color-line);
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--color-mint-soft) 56%, transparent));
  }

  .audience-card__number {
    color: var(--color-forest-bright);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .audience-card h3 {
    max-width: 13ch;
    margin: auto 0 var(--space-3);
    font-size: var(--step-2);
  }

  .audience-card p {
    color: var(--color-ink-soft);
  }

  .audience-card .text-link {
    margin-top: auto;
  }

  .principle-section {
    color: var(--color-paper);
    background:
      radial-gradient(circle at 12% 100%, rgb(31 111 120 / 70%), transparent 35%),
      var(--color-forest);
  }

  .principle-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(17rem, 0.75fr);
    gap: clamp(3rem, 8vw, 9rem);
  }

  .principle-section h2 {
    max-width: 13ch;
    margin: 0;
    color: inherit;
    font-size: var(--step-5);
  }

  .principle-section__copy p {
    color: var(--color-paper-muted);
  }

  .principle-section__copy .lead {
    color: var(--color-paper);
  }

  .capability-grid {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    list-style: none;
  }

  .capability-grid li {
    min-height: 22rem;
    padding: clamp(1.35rem, 2.5vw, 2rem);
    background: var(--color-surface);
  }

  .capability-grid span {
    display: block;
    margin-bottom: clamp(5rem, 8vw, 8rem);
    color: var(--color-forest-bright);
    font-size: 0.72rem;
    font-weight: 820;
  }

  .capability-grid h3 {
    margin-bottom: 0.7rem;
    font-size: var(--step-1);
  }

  .capability-grid p {
    margin-bottom: 0;
    color: var(--color-ink-soft);
    font-size: 0.91rem;
  }

  .product-feature {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .product-feature__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.72fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 9rem);
  }

  .product-feature__copy > h2 {
    max-width: 14ch;
    color: inherit;
    font-size: var(--step-4);
  }

  .product-feature__copy > p:not(.eyebrow) {
    max-width: 43rem;
    color: var(--color-paper-muted);
  }

  .product-feature__copy > .lead {
    color: var(--color-paper);
  }

  .product-feature__brand {
    display: flex;
    margin-bottom: clamp(3rem, 7vw, 6rem);
    align-items: center;
    gap: 0.8rem;
  }

  .product-feature__brand img {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 0.8rem;
  }

  .product-feature__brand span,
  .product-feature__brand strong {
    display: block;
  }

  .product-feature__brand span {
    color: var(--color-paper-muted);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-feature__brand strong {
    margin-top: 0.1rem;
    font-size: 1.3rem;
  }

  .collaboration-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(20rem, 0.88fr);
    gap: clamp(3rem, 9vw, 10rem);
  }

  .collaboration-grid__intro {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .collaboration-grid__intro h2 {
    max-width: 14ch;
    font-size: var(--step-4);
  }

  .collaboration-grid__intro p:not(.eyebrow) {
    color: var(--color-ink-soft);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(20rem, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .impact-grid > div:first-child h2 {
    max-width: 13ch;
    font-size: var(--step-4);
  }

  .impact-principles {
    border-top: 1px solid var(--color-line);
  }

  .impact-principles article {
    display: grid;
    padding-block: var(--space-5);
    grid-template-columns: 5rem 1fr;
    column-gap: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .impact-principles span {
    grid-row: 1 / span 2;
    color: var(--color-forest-bright);
    font-size: 0.7rem;
    font-weight: 820;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .impact-principles h3 {
    margin-bottom: 0.35rem;
    font-size: var(--step-1);
  }

  .impact-principles p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }

  .pathway-list {
    border-top: 1px solid var(--color-line);
  }

  .pathway-list a {
    display: grid;
    min-height: 6.5rem;
    padding-block: 1.1rem;
    grid-template-columns: 4rem minmax(10rem, 0.65fr) 1fr auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }

  .pathway-list a:hover {
    background: var(--color-mint-soft);
  }

  .pathway-list span {
    color: var(--color-forest-bright);
    font-size: 0.72rem;
    font-weight: 820;
  }

  .pathway-list strong {
    font-size: var(--step-1);
  }

  .pathway-list em {
    color: var(--color-muted);
    font-style: normal;
  }

  .pathway-list b {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
  }

  @media (max-width: 62rem) {
    .home-hero__inner,
    .principle-section__inner,
    .product-feature__inner,
    .collaboration-grid,
    .impact-grid {
      grid-template-columns: 1fr;
    }

    .home-hero__copy {
      max-width: 48rem;
    }

    .home-hero :global(.system-map) {
      margin-top: 1rem;
    }

    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .collaboration-grid__intro {
      position: static;
    }
  }

  @media (max-width: 44rem) {
    .stage-band__inner {
      padding-block: 1.25rem;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .audience-card {
      min-height: 19rem;
    }

    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability-grid li {
      min-height: 18rem;
    }

    .capability-grid span {
      margin-bottom: 4rem;
    }

    .pathway-list a {
      grid-template-columns: 2.5rem 1fr auto;
    }

    .pathway-list em {
      grid-column: 2 / -1;
      grid-row: 2;
    }

    .pathway-list b {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
