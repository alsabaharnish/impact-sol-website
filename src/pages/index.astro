---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import SystemMap from '../components/SystemMap.astro';
import ChokroFlow from '../components/ChokroFlow.astro';
import { siteConfig } from '../data/site';
import { getProduct } from '../content/read';

const chokro = await getProduct('chokro');
if (!chokro) throw new Error('The required Chokro product record is missing.');

const chokroStage = chokro.stage === 'working-prototype' ? 'Working prototype' : chokro.stage;

const audiences = [
  {
    number: '01',
    label: 'Maker pathway',
    title: 'Makers and small sellers',
    text: 'Share the product, practice or early idea you are building—and the operational or growth challenge in front of you.',
    href: '/get-involved/maker/',
    action: 'Tell us about your work',
  },
  {
    number: '02',
    label: 'Project pathway',
    title: 'Initiatives and social enterprises',
    text: 'Bring a defined participant need and a practical question about technology, delivery, learning or collaboration.',
    href: '/get-involved/partnership/',
    action: 'Describe your initiative',
  },
  {
    number: '03',
    label: 'Partnership pathway',
    title: 'Institutions and ecosystem partners',
    text: 'Explore a grounded role for your organisation in an environmental, enterprise, inclusion or public-interest challenge.',
    href: '/get-involved/partnership/',
    action: 'Propose a partnership',
  },
];

const capabilities = [
  {
    title: 'Design focused digital products',
    text: 'Shape and test tools around a defined environmental or social problem—not technology for its own sake.',
  },
  {
    title: 'Improve digital operations',
    text: 'Explore product design, day-to-day systems, learning and more responsible routes to market.',
  },
  {
    title: 'Frame delivery partnerships',
    text: 'Clarify the roles, resources, governance and safeguards a useful initiative may need.',
  },
  {
    title: 'Plan evidence and learning',
    text: 'Define meaningful signals early, state limitations clearly and use what is learned to improve the work.',
  },
];

const process = [
  {
    title: 'Understand the need',
    text: 'Listen to the people involved and define the problem, context, constraints and desired change.',
  },
  {
    title: 'Co-design the response',
    text: 'Agree what is useful, what is feasible, who owns each decision and how risk will be handled.',
  },
  {
    title: 'Build and implement',
    text: 'Create or adapt the right product, capability or partnership with proportionate checks along the way.',
  },
  {
    title: 'Measure and improve',
    text: 'Keep outputs and outcomes distinct, publish limitations and adjust the work as evidence develops.',
  },
];

const currentPosition = [
  {
    label: 'Impact Sol.',
    status: siteConfig.status,
    text: 'Organisation, services and commercial terms remain subject to formal establishment and approval.',
  },
  {
    label: 'Chokro',
    status: chokroStage,
    text: 'The prototype is not publicly available; its relationship and public-use rights still need to be documented.',
  },
  {
    label: 'Enquiries',
    status: 'Open for review',
    text: 'Messages can be submitted now, but no response time, product access or engagement is promised.',
  },
];
---

<BaseLayout
  title="Practical technology for eco-conscious enterprise"
  description="Impact Sol. is an early-stage initiative being established to support eco-conscious makers, sustainability projects and responsible partnerships through practical technology."
>
  <section class="home-hero">
    <div class="shell home-hero__inner">
      <div class="home-hero__copy">
        <p class="status-chip"><span aria-hidden="true"></span>Early stage · Being established</p>
        <h1>Practical technology for eco-conscious enterprise.</h1>
        <p class="lead">
          Impact Sol. is being established to support makers, small sellers and sustainability projects with focused digital products and responsible partnerships.
        </p>
        <div class="button-row">
          <a class="button" href="/get-involved/" data-event="primary_cta" data-placement="home_hero">Choose your pathway</a>
          <a class="text-link" href="/products/chokro/" data-event="product_click" data-placement="home_hero">Explore Chokro’s working prototype <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-hero__participation">
          <p><span aria-hidden="true"></span>Current ways to take part</p>
          <ul role="list">
            <li>Maker interest</li>
            <li>Project and partnership enquiries</li>
            <li>Prototype feedback</li>
          </ul>
        </div>
      </div>
      <SystemMap />
    </div>
  </section>

  <section class="section audience-section" aria-labelledby="audience-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Who this is for</p>
          <h2 id="audience-title">Choose the route that fits your role.</h2>
        </div>
        <p>
          Start with the context you know best. Each route opens an initial review—not an application, selection decision or promise of support.
        </p>
      </div>
      <div class="audience-grid">
        {audiences.map((audience) => (
          <a class="audience-card" href={audience.href} data-event="pathway_click" data-placement="home_audiences">
            <span class="audience-card__meta"><b aria-hidden="true">{audience.number}</b>{audience.label}</span>
            <h3>{audience.title}</h3>
            <p>{audience.text}</p>
            <span class="audience-card__action">
              {audience.action}
              <b aria-hidden="true">↗</b>
            </span>
          </a>
        ))}
      </div>
      <p class="audience-section__after">
        Something else in mind? <a href="/get-involved/#contributors">See every pathway</a> or <a href="/contact/">send a general enquiry</a>.
      </p>
    </div>
  </section>

  <section class="section model-section" aria-labelledby="model-title">
    <div class="shell model-grid">
      <div class="model-grid__intro">
        <p class="eyebrow">What we are setting up</p>
        <h2 id="model-title">Four practical areas, scoped case by case.</h2>
        <p>
          Technology belongs in the response only when it solves a real problem, strengthens trust or extends useful impact.
        </p>
        <a class="text-link" href="/what-we-do/">See capabilities and boundaries <span aria-hidden="true">→</span></a>
      </div>
      <ol class="capability-list" role="list">
        {capabilities.map((capability, index) => (
          <li>
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{capability.title}</h3>
            <p>{capability.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section product-feature" aria-labelledby="chokro-title">
    <div class="shell product-feature__inner">
      <div class="product-feature__copy">
        <div class="product-feature__brand">
          <img src="/assets/brand/chokro-app-icon.svg" width="54" height="54" alt="" />
          <div><span>Prototype under evaluation</span><strong>{chokro.name}</strong></div>
        </div>
        <p class="eyebrow eyebrow--light">Product experiment</p>
        <h2 id="chokro-title">Make responsible action visible—and connect it to a wider cycle.</h2>
        <p class="lead">
          {chokro.tagline} The prototype explores responsible disposal, reviewed eco-actions, internal rewards and a marketplace pathway for small eco-conscious sellers.
        </p>
        <div class="product-feature__status">
          <strong>{chokroStage}</strong>
          <span>Not publicly available. {chokro.ownershipNote}</span>
        </div>
        <div class="button-row">
          <a class="button button--sun" href="/products/chokro/" data-event="product_click" data-placement="home_feature">Explore the prototype</a>
          <a class="text-link text-link--light" href="/get-involved/maker/" data-event="pathway_click" data-placement="home_feature">Register maker or initiative interest <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ChokroFlow />
    </div>
  </section>

  <section class="section approach-section" aria-labelledby="approach-title">
    <div class="shell">
      <div class="approach-grid">
        <div class="approach-grid__intro">
          <p class="eyebrow">How a collaboration would begin</p>
          <h2 id="approach-title">Start with the need. Keep learning in the loop.</h2>
          <p>
            Roles, outputs, safeguards, limitations and decisions should be clear before work begins.
          </p>
          <a class="button button--secondary" href="/get-involved/">Choose a collaboration pathway</a>
        </div>
        <ol class="process-list" role="list">
          {process.map((step, index) => (
            <li>
              <span aria-hidden="true">0{index + 1}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="evidence-panel" aria-labelledby="evidence-title">
        <div>
          <p class="eyebrow">Our standard</p>
          <h2 id="evidence-title">Claims should follow evidence—not ambition.</h2>
        </div>
        <div>
          <p>
            The launch framework separates intended change, product activity and verified outcomes. No organisation-level impact results are claimed yet.
          </p>
          <a class="text-link" href="/impact/">Read the measurement approach <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section stage-section" aria-labelledby="stage-title">
    <div class="shell">
      <div class="stage-section__heading">
        <div>
          <p class="eyebrow">Current position</p>
          <h2 id="stage-title">Clear about what exists today.</h2>
        </div>
        <a class="text-link" href="/about/#current-stage">Read the full stage disclosure <span aria-hidden="true">→</span></a>
      </div>
      <dl class="stage-ledger">
        {currentPosition.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd><strong><span aria-hidden="true"></span>{item.status}</strong>{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBand
    eyebrow="Begin a conversation"
    title="Bring a real need, an open question or a useful perspective."
    text="Choose the closest route and share enough context for an initial review. Sending an enquiry does not create an agreement or promise a response."
    href="/get-involved/"
    label="Choose your pathway"
    secondaryHref="/contact/"
    secondaryLabel="Send a general enquiry"
  />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: clip;
    padding: clamp(3.5rem, 6.5vw, 6.5rem) 0 clamp(4rem, 7vw, 7rem);
    background:
      radial-gradient(circle at 91% 4%, color-mix(in srgb, var(--color-sun-soft) 40%, transparent), transparent 25rem),
      linear-gradient(145deg, var(--color-paper) 56%, color-mix(in srgb, var(--color-mint-soft) 76%, var(--color-paper)));
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 68%, transparent);
  }

  .home-hero::before {
    position: absolute;
    top: 0;
    left: max(var(--gutter), calc((100vw - var(--shell)) / 2));
    width: clamp(4rem, 9vw, 7rem);
    height: 3px;
    background: var(--color-sun);
    content: '';
  }

  .home-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    align-items: center;
    gap: clamp(2.75rem, 5.5vw, 6.5rem);
  }

  .home-hero__copy {
    position: relative;
    z-index: 1;
  }

  .home-hero .status-chip {
    width: fit-content;
  }

  .home-hero .status-chip span,
  .home-hero__participation > p span {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    background: var(--color-sun-deep);
    border-radius: 50%;
  }

  h1 {
    max-width: 16ch;
    margin: var(--space-4) 0 0;
    font-size: clamp(2.85rem, 2.25rem + 2.2vw, 4.25rem);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-wrap: balance;
  }

  .home-hero .lead {
    max-width: 39rem;
    margin-top: var(--space-4);
  }

  .home-hero__participation {
    max-width: 43rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-line-strong) 45%, transparent);
  }

  .home-hero__participation > p {
    display: flex;
    margin: 0 0 0.7rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.76rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    line-height: var(--leading-snug);
    text-transform: uppercase;
  }

  .home-hero__participation ul {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }

  .home-hero__participation li {
    padding: 0.35rem 0.68rem;
    border: 1px solid color-mix(in srgb, var(--color-line-strong) 52%, transparent);
    color: var(--color-ink-soft);
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    border-radius: var(--radius-pill);
    font-size: 0.76rem;
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .audience-section {
    background: var(--color-paper);
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.8rem);
  }

  .audience-card {
    display: flex;
    min-height: 100%;
    padding: clamp(1.45rem, 2.8vw, 2.25rem);
    flex-direction: column;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .audience-card:hover {
    border-color: color-mix(in srgb, var(--color-forest) 34%, var(--color-line));
    box-shadow: var(--shadow-md);
    text-decoration: none;
    transform: translateY(-3px);
  }

  .audience-card__meta {
    display: flex;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
    align-items: center;
    gap: 0.65rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .audience-card__meta b {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    color: var(--color-forest);
    background: var(--color-mint-soft);
    border-radius: 50%;
    font-size: 0.68rem;
  }

  .audience-card h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-2);
  }

  .audience-card p {
    margin-bottom: var(--space-5);
    flex-grow: 1;
    color: var(--color-ink-soft);
  }

  .audience-card__action {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-forest);
    font-weight: var(--weight-semibold);
  }

  .audience-card__action b {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    border-radius: 50%;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .audience-card:hover .audience-card__action b {
    color: var(--color-paper);
    background: var(--color-forest);
    transform: translate(0.12rem, -0.12rem);
  }

  .audience-section__after {
    margin: var(--space-5) 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
    text-align: center;
  }

  .model-section {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .model-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .model-grid__intro {
    position: sticky;
    top: 7rem;
  }

  .model-grid__intro h2,
  .approach-grid__intro h2,
  .stage-section__heading h2 {
    max-width: var(--measure-heading);
    margin-bottom: var(--space-4);
    font-size: var(--step-4);
  }

  .model-grid__intro > p:not(.eyebrow),
  .approach-grid__intro > p:not(.eyebrow) {
    color: var(--color-ink-soft);
  }

  .capability-list {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 4vw, 4rem);
    list-style: none;
  }

  .capability-list li {
    padding: var(--space-5) 0 clamp(2rem, 4vw, 3.25rem);
    border-top: 1px solid var(--color-line-strong);
  }

  .capability-list > li > span {
    display: block;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-forest-bright);
    font-size: 0.72rem;
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-caps);
  }

  .capability-list h3 {
    margin-bottom: var(--space-3);
    font-size: var(--step-1);
  }

  .capability-list p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.91rem;
  }

  .product-feature {
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(4rem, 7vw, 7rem);
    background: var(--color-surface);
  }

  .product-feature__inner {
    display: grid;
    padding: clamp(2rem, 5.5vw, 4.75rem);
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.72fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
    overflow: hidden;
    color: var(--color-paper);
    background:
      radial-gradient(circle at 92% 6%, color-mix(in srgb, var(--color-sun) 16%, transparent), transparent 24rem),
      var(--color-ink);
    border-radius: var(--radius-lg);
  }

  .product-feature__copy > h2 {
    max-width: var(--measure-heading);
    color: inherit;
    font-size: var(--step-4);
  }

  .product-feature__copy > p:not(.eyebrow) {
    max-width: 43rem;
    color: var(--color-paper-muted);
  }

  .product-feature__copy > .lead {
    color: var(--color-paper);
  }

  .product-feature__brand {
    display: flex;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
    align-items: center;
    gap: 0.85rem;
  }

  .product-feature__brand img {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 0.8rem;
  }

  .product-feature__brand span,
  .product-feature__brand strong {
    display: block;
  }

  .product-feature__brand span {
    color: var(--color-paper-muted);
    font-size: 0.68rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .product-feature__brand strong {
    margin-top: 0.1rem;
    font-size: 1.3rem;
  }

  .product-feature__status {
    display: grid;
    max-width: 43rem;
    margin-top: var(--space-5);
    padding: var(--space-4);
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.8rem 1rem;
    border: 1px solid rgb(255 255 255 / 16%);
    background: rgb(255 255 255 / 5%);
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    line-height: var(--leading-snug);
  }

  .product-feature__status strong {
    color: var(--color-sun-soft);
    white-space: nowrap;
  }

  .product-feature__status span {
    color: var(--color-paper-muted);
  }

  .approach-section {
    background: color-mix(in srgb, var(--color-mint-soft) 72%, var(--color-paper));
  }

  .approach-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(20rem, 0.95fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .approach-grid__intro {
    align-self: start;
  }

  .process-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    padding: 0 0 var(--space-5);
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  .process-list li + li {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .process-list > li > span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    color: var(--color-paper);
    background: var(--color-forest);
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: var(--weight-bold);
  }

  .process-list h3 {
    margin: 0 0 0.35rem;
    font-size: var(--step-1);
  }

  .process-list p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.93rem;
  }

  .evidence-panel {
    display: grid;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding: clamp(1.75rem, 4.5vw, 3.5rem);
    grid-template-columns: minmax(0, 0.92fr) minmax(17rem, 0.72fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    border: 1px solid var(--color-line);
    background:
      radial-gradient(circle at 96% 0%, color-mix(in srgb, var(--color-sun-soft) 38%, transparent), transparent 18rem),
      var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .evidence-panel h2 {
    max-width: 20ch;
    margin: 0;
    font-size: var(--step-3);
  }

  .evidence-panel > div:last-child p {
    margin: 0 0 var(--space-3);
    color: var(--color-ink-soft);
  }

  .stage-section {
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    background: var(--color-paper);
  }

  .stage-section__heading {
    display: flex;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .stage-section__heading h2 {
    margin-bottom: 0;
  }

  .stage-ledger {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--color-line-strong);
  }

  .stage-ledger > div {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .stage-ledger > div + div {
    border-left: 1px solid var(--color-line);
  }

  .stage-ledger dt {
    margin-bottom: var(--space-3);
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .stage-ledger dd {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.87rem;
  }

  .stage-ledger dd strong {
    display: flex;
    margin-bottom: 0.65rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-forest);
