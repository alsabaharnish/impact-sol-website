---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/pages/FaqList.astro';
import StatusPanel from '../components/pages/StatusPanel.astro';
import { getFaqs, getOfferings } from '../content/read';

const breadcrumbs = [{ name: 'What we do', path: '/what-we-do/' }];
const [offerings, faqs] = await Promise.all([getOfferings(), getFaqs('work')]);
---

<BaseLayout
  title="What we do"
  description="The planned role of products, partnerships and evidence in Impact Sol.’s practical approach to public-interest challenges."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={[{ label: 'What we do' }]} />
  <PageHero
    eyebrow="What we do"
    title="Turn shared challenges into testable work."
    intro="Our intended model brings together focused digital products, thoughtful partnerships and evidence-led learning. The scope is still being established."
  >
    <div class="button-row">
      <a class="button" href="#workstreams">Explore the model</a>
      <a class="text-link" href="/get-involved/">Share an idea <span aria-hidden="true">→</span></a>
    </div>
    <div slot="aside">
      <StatusPanel
        title="A planned model, not a published service catalogue"
        text="These workstreams describe the direction under development. Specific offers, fees, eligibility and geography will only be published after they are approved."
      />
    </div>
  </PageHero>

  <section class="section" id="workstreams" tabindex="-1">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <p class="eyebrow">Four intended capability areas</p>
        <h2>Build, enable, connect and improve.</h2>
        <p>These pathways are CMS-managed proposals rather than a fixed service catalogue. Scope, team, timing and delivery commitments would be agreed before work begins.</p>
      </div>

      <div class="workstream-list">
        {offerings.map((offering, index) => (
          <article>
            <div class="workstream-list__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <p class="eyebrow">{offering.status}</p>
              <h3>{offering.title}</h3>
              <ul class="audience-list" aria-label={`Intended for ${offering.title}`}>
                {offering.intendedFor.map((audience) => <li>{audience}</li>)}
              </ul>
            </div>
            <div>
              <p>{offering.summary}</p>
              <p class="workstream-detail">{offering.detail}</p>
              <details class="offering-detail">
                <summary>Scope, boundaries and expected outputs</summary>
                <div>
                  <h4>Problem addressed</h4>
                  <p>{offering.problem}</p>
                  <div class="offering-detail__columns">
                    <div>
                      <h4>What may be provided</h4>
                      <ul>{offering.provides.map((item) => <li>{item}</li>)}</ul>
                    </div>
                    <div>
                      <h4>What is not included</h4>
                      <ul>{offering.exclusions.map((item) => <li>{item}</li>)}</ul>
                    </div>
                  </div>
                  <h4>Intended process</h4>
                  <p>{offering.process}</p>
                  <h4>Expected outputs</h4>
                  <ul>{offering.expectedOutputs.map((item) => <li>{item}</li>)}</ul>
                  <h4>Availability and model</h4>
                  <p>{offering.modelNote}</p>
                  <p><strong>Evidence:</strong> No completed engagement evidence is published for this proposed area.</p>
                </div>
              </details>
              <a class="text-link" href="/get-involved/#partnership-enquiry">Discuss this pathway <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="process-title">
    <div class="shell process">
      <div class="process__intro">
        <p class="eyebrow">A practical cycle</p>
        <h2 id="process-title">Small enough to learn. Clear enough to question.</h2>
        <p>This is the intended development rhythm. A project may stop at any stage if the need, safety case or value is not strong enough.</p>
      </div>
      <ol>
        <li><span>Listen</span><p>Understand the context, constraints and people affected before settling on a solution.</p></li>
        <li><span>Frame</span><p>Agree the problem, intended outcome, risks and what would count as useful evidence.</p></li>
        <li><span>Prototype</span><p>Create the smallest responsible version that can answer an important question.</p></li>
        <li><span>Test</span><p>Observe real use, seek criticism and check accessibility, privacy and unintended effects.</p></li>
        <li><span>Decide</span><p>Improve, pause, retire or scale based on evidence—not momentum alone.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="guardrails-title">
    <div class="shell guardrails">
      <div>
        <p class="eyebrow">Decision guardrails</p>
        <h2 id="guardrails-title">What every piece of work should make clear.</h2>
      </div>
      <ul>
        <li><strong>The need</strong><span>Whose problem is being addressed, and how do we know it matters?</span></li>
        <li><strong>The role</strong><span>What can a digital product or partnership reasonably contribute?</span></li>
        <li><strong>The power</strong><span>Who can decide, participate, challenge and leave?</span></li>
        <li><strong>The risk</strong><span>What could go wrong, and who may carry that cost?</span></li>
        <li><strong>The evidence</strong><span>What will be measured, by whom, and with what limitations?</span></li>
        <li><strong>The end</strong><span>How can the work be changed, handed over or retired responsibly?</span></li>
      </ul>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="shell"><FaqList items={faqs} /></div>
  </section>

  <CtaBand
    eyebrow="Work with us"
    title="A useful collaboration starts with a clear question."
    text="Share the challenge, who it affects and what a good next step might look like."
    href="/get-involved/#partnership-enquiry"
    label="Propose a partnership"
    secondaryHref="/contact/"
    secondaryLabel="Ask a general question"
  />
</BaseLayout>

<style>
  .workstream-list {
    margin-top: var(--space-7);
    border-top: 1px solid var(--color-line);
  }

  .workstream-list article {
    display: grid;
    grid-template-columns: 4rem minmax(13rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: clamp(2rem, 5vw, 4rem) 0;
    align-items: start;
    border-bottom: 1px solid var(--color-line);
  }

  .workstream-list__number {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-teal);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .workstream-list h3 {
    max-width: 15ch;
    margin-top: var(--space-2);
  }

  .workstream-list article > div:last-child > p {
    margin-top: 0;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .workstream-list article > div:last-child > .workstream-detail {
    font-size: 1rem;
  }

  .offering-detail {
    margin-block: var(--space-5);
    border-block: 1px solid var(--color-line);
  }

  .offering-detail summary {
    display: flex;
    min-height: 52px;
    align-items: center;
    color: var(--color-forest);
    cursor: pointer;
    font-weight: 760;
  }

  .offering-detail > div {
    padding-bottom: var(--space-5);
  }

  .offering-detail h4 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: 0.9rem;
    letter-spacing: 0;
  }

  .offering-detail p,
  .offering-detail li {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .offering-detail ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .offering-detail__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .audience-list {
    display: flex;
    margin: var(--space-3) 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .audience-list li {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  .process {
    display: grid;
    grid-template-columns: minmax(14rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .process__intro {
    position: sticky;
    top: 7rem;
  }

  .process ol {
    margin: 0;
    padding: 0;
    counter-reset: process;
    list-style: none;
  }

  .process li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(7rem, 0.45fr) minmax(0, 1.55fr);
    gap: var(--space-4);
    padding: var(--space-5) 0 var(--space-5) 3.25rem;
    border-top: 1px solid var(--color-line);
    counter-increment: process;
  }

  .process li::before {
    position: absolute;
    top: 1.55rem;
    left: 0;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: var(--color-paper);
    background: var(--color-forest);
    content: counter(process, decimal-leading-zero);
    font-size: 0.68rem;
    font-weight: 750;
  }

  .process li span {
    color: var(--color-ink);
    font-size: var(--step-1);
    font-weight: 760;
  }

  .process li p {
    margin: 0;
    color: var(--color-muted);
  }

  .guardrails {
    display: grid;
    grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 7vw, 7rem);
  }

  .guardrails ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .guardrails li {
    display: grid;
    gap: 0.5rem;
    padding: var(--space-4);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .guardrails li:nth-child(odd) {
    border-left: 1px solid var(--color-line);
  }

  .guardrails li span {
    color: var(--color-muted);
  }

  @media (max-width: 48rem) {
    .workstream-list article,
    .process,
    .guardrails {
      grid-template-columns: 1fr;
    }

    .workstream-list article {
      gap: var(--space-4);
    }

    .process__intro {
      position: static;
    }
  }

  @media (max-width: 34rem) {
    .process li,
    .guardrails ul,
    .offering-detail__columns {
      grid-template-columns: 1fr;
    }
  }
</style>
