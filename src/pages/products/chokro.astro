---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import ChokroFlow from '../../components/ChokroFlow.astro';
import FaqList from '../../components/pages/FaqList.astro';
import { getFaqs, getProduct } from '../../content/read';

const breadcrumbs = [
  { name: 'Products', path: '/products/' },
  { name: 'Chokro', path: '/products/chokro/' },
];
const product = await getProduct('chokro');
if (!product) throw new Error('The Chokro product record is missing.');
const cmsFaqs = await getFaqs('products');
const faqs = [
  ...cmsFaqs,
  {
    question: 'What does a verified bin submission prove?',
    answer:
      'It can provide evidence of collection under the prototype rules. It is not proof that material was recycled. No kilogram is defensible without verified product mass, and no collection percentage is defensible without a producer’s put-on-market declaration.',
  },
  {
    question: 'Are Chokro points money or charitable donations?',
    answer:
      'No. Prototype points are internal rewards. They cannot be purchased, transferred or withdrawn, and a point contribution does not prove that a corresponding field project was delivered or create a tax-deductible donation.',
  },
  {
    question: 'Does a Greenpreneur label certify a seller or product?',
    answer:
      'No. Greenpreneur is a product-role label, not an independent environmental certification. A public marketplace would require an approved eligibility and environmental-claims standard before stronger seller or product claims could be made.',
  },
];

const currentStatus =
  'Working prototype. Android, iOS, and web code exists; public availability, native app links, and browser QR entry remain subject to production-release verification.';
---

<BaseLayout
  title="Chokro — working prototype"
  description="How the Chokro working prototype approaches responsible disposal, reviewed eco-actions, internal rewards, small-seller pathways, and evidence boundaries."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={[{ label: 'Products', href: '/products/' }, { label: 'Chokro' }]} />
  <PageHero
    eyebrow="Working prototype · Reviewed 9 September 2026"
    title="Make responsible action visible—and connect it to a wider cycle."
    intro="Chokro is a cross-platform prototype designed to make responsible disposal and other eco-actions visible and rewarding, while exploring a marketplace pathway for small eco-conscious sellers."
  >
    <div class="button-row">
      <a class="button" href="/get-involved/#chokro-interest" data-event="register_interest" data-placement="chokro_hero">Register interest</a>
      <a class="text-link" href="#how-it-works">See the current approach <span aria-hidden="true">↓</span></a>
    </div>
    <div slot="aside" class="product-status">
      <div class="product-status__brand">
        <img src="/assets/brand/chokro-app-icon.svg" width="104" height="104" alt="Chokro prototype app icon" />
        <div><strong>{product.name}</strong><span>{product.stage.replace('-', ' ')}</span></div>
      </div>
      <dl>
        <div><dt>Availability</dt><dd>Not publicly released</dd></div>
        <div><dt>Designed for</dt><dd>Bangladesh; focused Dhaka pilot planned</dd></div>
        <div><dt>Product relationship</dt><dd>Proposed; ownership or licence not yet documented</dd></div>
        <div><dt>Public action</dt><dd>Register interest</dd></div>
      </dl>
    </div>
  </PageHero>

  <section class="status-strip" aria-label="Product status">
    <div class="shell"><strong>Current public status</strong><p>{currentStatus}</p></div>
  </section>

  <section class="section" aria-labelledby="problem-title">
    <div class="shell problem-layout">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title">Two gaps that can reinforce each other.</h2>
        <p class="lead">The prototype explores one participation cycle rather than treating disposal and local enterprise as unrelated experiences.</p>
      </div>
      <div class="problem-cards">
        <article>
          <span aria-hidden="true">01</span>
          <h3>Responsible disposal is poorly rewarded</h3>
          <p>A person’s effort at the point of disposal can remain invisible. Without appropriate attribution and checks, it is difficult to recognise the behaviour responsibly.</p>
        </article>
        <article>
          <span aria-hidden="true">02</span>
          <h3>Small eco-conscious sellers lack a dedicated pathway</h3>
          <p>Makers can depend on fragmented channels and carry little portable context. The prototype explores a more relevant route without claiming an active seller base or certified products.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="how-it-works" tabindex="-1" aria-labelledby="approach-title">
    <div class="shell current-approach">
      <div>
        <p class="eyebrow eyebrow--light">What exists in the prototype</p>
        <h2 id="approach-title">A traceable route from action to review.</h2>
        <p>The codebase contains product journeys across Android, iOS, and web. This describes implemented prototype capability—not public availability, verified operations, or measured impact.</p>
        <div class="current-approach__visual"><ChokroFlow /></div>
      </div>
      <div class="capability-list">
        <article>
          <span>Registered-bin disposal</span>
          <h3>Evidence proportionate to the reward path</h3>
          <p>A bin link or QR entry can lead to a submission using a photograph, location, duplicate checks, time or rate limits, and automated screening. Uncertainty routes to a person rather than directly to a reward.</p>
        </article>
        <article>
          <span>Reviewed eco-actions</span>
          <h3>A different route with a different assurance level</h3>
          <p>Self-reported eco-actions do not use a registered bin or geofence. They are always reviewed by a person, so the interface and public explanation must never imply the same verification as a bin submission.</p>
        </article>
        <article>
          <span>Internal reward ledger</span>
          <h3>Points with a recorded source</h3>
          <p>The prototype uses a server-controlled ledger so the client cannot award itself points. Points are internal rewards—not money—and contribution categories remain distinct from evidence that field work occurred.</p>
        </article>
        <article>
          <span>Prototype marketplace</span>
          <h3>A possible path toward local enterprise</h3>
          <p>Prototype software includes listings, discovery, cart, and checkout journeys. Payment screens simulate bKash, Nagad, and card flows; they collect no payment credentials and move no real money.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="assurance-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Assurance boundaries</p><h2 id="assurance-title">Similar action cards do not mean identical evidence.</h2></div>
        <p>The clearest product explanation is explicit about what each route checks, what a device can prove, and when a person makes the decision.</p>
      </div>
      <div class="comparison" role="region" aria-label="Comparison of prototype evidence routes" tabindex="0">
        <table>
          <thead><tr><th scope="col">Question</th><th scope="col">Registered-bin disposal</th><th scope="col">Self-reported eco-action</th></tr></thead>
          <tbody>
            <tr><th scope="row">Entry</th><td>Registered bin link or QR path</td><td>Selected action submitted without a bin</td></tr>
            <tr><th scope="row">Evidence checks</th><td>Photo, location, duplicate, time or rate limit, and automated screening</td><td>Submitted context reviewed by a person; no geofence</td></tr>
            <tr><th scope="row">Decision</th><td>Clear mechanical checks may support an automated result; uncertainty goes to human review</td><td>Always human reviewed</td></tr>
            <tr><th scope="row">Camera boundary</th><td>Native use requires a new camera capture; a browser file chooser cannot prove the selected image is fresh</td><td>Evidence expectations depend on the action and review rule</td></tr>
            <tr><th scope="row">What approval supports</th><td>A prototype reward decision and evidence of collection under the route</td><td>A prototype reward decision for the reviewed action</td></tr>
            <tr><th scope="row">What it does not prove</th><td>Recycling, regulatory compliance, a defensible weight without verified mass, or an environmental outcome</td><td>Independent certification, causation, or an environmental outcome</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">The table scrolls horizontally only if a narrow screen cannot preserve the genuinely two-dimensional comparison.</p>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="roles-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Product roles</p><h2 id="roles-title">Three interface roles, with clear limits.</h2></div>
        <p>These labels describe roles inside the Chokro prototype. They do not establish affiliation with the 3ZERO organisation or movement, and public use still requires permission and trademark review.</p>
      </div>
      <div class="roles-grid">
        <article><span>Participant</span><h3>3ZERO Champion</h3><p>Uses participant journeys such as bin entry, reviewed eco-actions, the prototype marketplace, internal points, and initiative contribution categories.</p></article>
        <article><span>Seller</span><h3>3ZERO Greenpreneur</h3><p>Uses prototype seller journeys in addition to participant access. Approval is a platform role, not independent environmental certification.</p></article>
        <article><span>Administration</span><h3>3ZERO Admin</h3><p>Reviews uncertain submissions and manages prototype operations through trusted controls. The label does not imply outside endorsement.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="epr-title">
    <div class="shell epr-layout">
      <div>
        <p class="eyebrow">EPR boundary</p>
        <h2 id="epr-title">Evidence in development—not a compliance verdict.</h2>
      </div>
      <div class="epr-copy">
        <p>Chokro is currently an evidence and reporting provider in development. It must not be described as Department of Environment approved, an accredited Producer Responsibility Organisation, legally sufficient for EPR compliance, or operating at production scale without documentary evidence and legal approval.</p>
        <ul>
          <li>A producer remains legally responsible and files with the Department of Environment.</li>
          <li>A verified bin submission is evidence of collection, not proof of recycling.</li>
          <li>No kilogram is defensible without a verified product mass.</li>
          <li>No collection percentage is defensible without the producer’s put-on-market declaration.</li>
          <li>Only the regulator can determine whether a legal obligation is met.</li>
        </ul>
        <div class="notice notice--warning"><strong>Roadmap, not current capability:</strong> production Plastic Passports and end-to-end EPR reporting remain possible future capabilities and have no public release date here.</div>
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="stage-title">
    <div class="shell stage-map">
      <div>
        <p class="eyebrow eyebrow--light">Current, pilot, roadmap</p>
        <h2 id="stage-title">Keep each maturity level separate.</h2>
      </div>
      <div class="stage-map__list">
        <article><span>Current code</span><h3>Working cross-platform prototype</h3><p>Android, iOS, web, and trusted-service code exists. Product journeys remain subject to release, privacy, security, support, and operational verification.</p></article>
        <article><span>Planned validation</span><h3>Focused Dhaka pilot</h3><p>Chokro is designed for Bangladesh with a focused Dhaka pilot planned. No current physical-bin operation, collection partner, recycler arrangement, or public pilot is claimed.</p></article>
        <article><span>Unconfirmed roadmap</span><h3>Production operations and integrations</h3><p>Public app links, unrestricted QR entry, real payment processing, Plastic Passports, and end-to-end EPR reporting remain gated or future work—not current features.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="alignment-title">
    <div class="shell alignment-layout">
      <div>
        <p class="eyebrow">Contribution areas</p>
        <h2 id="alignment-title">Conceptual alignment—not certification or outcome.</h2>
        <p>Chokro has defensible conceptual alignment with selected Sustainable Development Goal targets. These product-level signals do not become organisation-level Impact Sol. outcomes and are not official UN indicators, audited results, certification, or a progress score.</p>
      </div>
      <dl>
        <div><dt>8.3</dt><dd>Productive activities, entrepreneurship, and the growth of small and medium-sized enterprises</dd></div>
        <div><dt>11.6</dt><dd>Reducing the environmental impact of cities, including waste management</dd></div>
        <div><dt>12.5</dt><dd>Reducing waste generation through prevention, reduction, recycling, and reuse</dd></div>
        <div><dt>13.3</dt><dd>Education, awareness, and capacity related to climate action</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="release-title">
    <div class="shell release-grid">
      <div>
        <p class="eyebrow">Before public use</p>
        <h2 id="release-title">Release depends on more than working code.</h2>
        <p>Production availability requires verified routes, product-specific privacy and terms, processor and retention details, security checks, support ownership, approved public links, and documented rights for the name, software, media, and relationship to Impact Sol.</p>
        <p>Approved product screenshots are not published in this build because no rights-cleared, current release set was supplied. The diagram above is explicitly representative and is not presented as a live screen.</p>
      </div>
      <aside class="release-card">
        <span class="status-chip">Register interest only</span>
        <h3>No “Try Chokro” route is active</h3>
        <p>A public-use link should appear only after availability and the privacy, security, support, and release gates are verified.</p>
        <a class="button" href="/get-involved/#chokro-interest">Register interest</a>
        <a class="text-link" href="/contact/">Ask a product question <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="shell"><FaqList title="Chokro questions" items={faqs} /></div>
  </section>

  <CtaBand
    eyebrow="Register interest"
    title="Help test whether the problem and safeguards are framed correctly."
    text="Share your perspective as a maker, initiative lead, potential participant, institution, or subject specialist. An enquiry does not promise access or create a partnership."
    href="/get-involved/#chokro-interest"
    label="Share your perspective"
    secondaryHref="/impact/"
    secondaryLabel="Read the evidence approach"
  />
</BaseLayout>

<style>
  .product-status {
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, white 88%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .product-status__brand { display: flex; align-items: center; gap: 1rem; }
  .product-status__brand img { width: 4.8rem; height: 4.8rem; border-radius: 1.1rem; }
  .product-status__brand strong, .product-status__brand span { display: block; }
  .product-status__brand strong { font-size: var(--step-2); }
  .product-status__brand span { margin-top: 0.15rem; color: var(--color-muted); font-size: 0.8rem; text-transform: capitalize; }
  .product-status dl { margin: var(--space-5) 0 0; }
  .product-status dl div { display: grid; padding-block: 0.65rem; grid-template-columns: 7.5rem 1fr; gap: 1rem; border-top: 1px solid var(--color-line); }
  .product-status dt { color: var(--color-muted); font-size: 0.78rem; }
  .product-status dd { margin: 0; font-size: 0.83rem; font-weight: var(--weight-semibold); }

  .status-strip { color: var(--color-paper); background: var(--color-ink); }
  .status-strip > div { display: grid; min-height: 6rem; padding-block: 1rem; grid-template-columns: 10rem 1fr; align-items: center; gap: 1.5rem; }
  .status-strip strong { color: var(--color-mint); font-size: 0.76rem; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .status-strip p { margin: 0; color: var(--color-paper-muted); font-size: 0.88rem; }

  .problem-layout, .epr-layout, .stage-map, .alignment-layout, .release-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
  }

  .problem-layout h2, .epr-layout h2, .stage-map h2, .alignment-layout h2, .release-grid h2 { max-width: var(--measure-heading); font-size: var(--step-4); }
  .problem-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--color-line); border-left: 1px solid var(--color-line); }
  .problem-cards article { min-height: 22rem; padding: clamp(1.4rem, 3vw, 2.2rem); border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .problem-cards span { display: block; margin-bottom: clamp(4rem, 8vw, 7rem); color: var(--color-teal); font-size: 0.74rem; font-weight: var(--weight-black); }
  .problem-cards h3 { font-size: var(--step-1); }
  .problem-cards p { color: var(--color-muted); }

  .current-approach { display: grid; grid-template-columns: minmax(17rem, 0.75fr) minmax(0, 1.25fr); gap: clamp(3rem, 8vw, 8rem); }
  .current-approach h2 { max-width: var(--measure-heading); color: inherit; font-size: var(--step-4); }
  .current-approach > div:first-child > p:not(.eyebrow) { color: var(--color-paper-muted); }
  .current-approach__visual { margin-top: var(--space-6); }
  .capability-list { border-top: 1px solid rgb(255 255 255 / 18%); }
  .capability-list article { padding-block: var(--space-5); border-bottom: 1px solid rgb(255 255 255 / 18%); }
  .capability-list span { color: var(--color-mint); font-size: 0.72rem; font-weight: var(--weight-black); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .capability-list h3 { margin: 0.45rem 0; color: inherit; font-size: var(--step-1); }
  .capability-list p { margin: 0; color: var(--color-paper-muted); font-size: 0.9rem; }

  .comparison { max-width: 100%; margin-top: var(--space-6); overflow-x: auto; overscroll-behavior-x: contain; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
  table { width: 100%; min-width: 48rem; border-collapse: separate; border-spacing: 0; background: var(--color-surface); }
  th, td { padding: 0.95rem 1rem; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); text-align: left; vertical-align: top; }
  tr > :last-child { border-right: 0; }
  tbody tr:last-child :is(th, td) { border-bottom: 0; }
  thead th { position: sticky; top: 0; z-index: 2; color: var(--color-paper); background: var(--color-forest); font-size: 0.78rem; font-weight: var(--weight-semibold); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  /* The question column stays put while the two routes are compared. */
  tbody th { position: sticky; left: 0; z-index: 1; width: 11rem; color: var(--color-forest); background: var(--color-mint-soft); box-shadow: 1px 0 0 var(--color-line); font-size: 0.84rem; font-weight: var(--weight-semibold); }
  tbody td { color: var(--color-ink-soft); font-size: 0.88rem; line-height: var(--leading-snug); }
  tbody tr:hover td { background: color-mix(in srgb, var(--color-mint-soft) 40%, var(--color-surface)); }
  .table-note { margin-top: var(--space-3); color: var(--color-muted); font-size: 0.8rem; }

  .roles-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .roles-grid article { padding: clamp(1.4rem, 3vw, 2.1rem); border: 1px solid var(--color-line); background: var(--color-surface); border-radius: var(--radius-md); }
  .roles-grid span, .stage-map__list span { color: var(--color-teal); font-size: 0.7rem; font-weight: var(--weight-black); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .roles-grid h3, .stage-map__list h3 { margin: var(--space-4) 0 var(--space-3); font-size: var(--step-1); }
  .roles-grid p { margin: 0; color: var(--color-muted); }

  .epr-copy > p, .epr-copy li { color: var(--color-ink-soft); }
  .epr-copy li + li { margin-top: 0.65rem; }
  .epr-copy .notice { margin-top: var(--space-5); }

  .stage-map h2 { color: inherit; }
  /* 260px intro beside a 634px stage list. */
  .stage-map > div:first-child { position: sticky; top: 7rem; }
  .stage-map__list { border-top: 1px solid rgb(255 255 255 / 18%); }
  .stage-map__list article { padding-block: var(--space-5); border-bottom: 1px solid rgb(255 255 255 / 18%); }
  .stage-map__list h3 { color: inherit; }
  .stage-map__list p { color: var(--color-paper-muted); }

  .alignment-layout > div > p:last-child { color: var(--color-muted); }
  .alignment-layout dl { margin: 0; border-top: 1px solid var(--color-line); }
  .alignment-layout dl div { display: grid; padding-block: var(--space-4); grid-template-columns: 4rem 1fr; gap: 1rem; border-bottom: 1px solid var(--color-line); }
  .alignment-layout dt { color: var(--color-forest); font-size: var(--step-1); font-weight: var(--weight-black); }
  .alignment-layout dd { margin: 0; color: var(--color-muted); }

  .release-grid > div > p:not(.eyebrow) { color: var(--color-muted); }
  .release-card { padding: clamp(1.4rem, 3vw, 2.2rem); border: 1px solid var(--color-line); background: var(--color-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .release-card h3 { margin-top: var(--space-5); font-size: var(--step-2); }
  .release-card p { color: var(--color-muted); }
  .release-card .button { margin-top: var(--space-3); }
  .release-card .text-link { display: flex; margin-top: var(--space-3); }

  @media (max-width: 58rem) {
    .problem-layout, .current-approach, .epr-layout, .stage-map, .alignment-layout, .release-grid { grid-template-columns: 1fr; }
    .stage-map > div:first-child { position: static; }
    .roles-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 40rem) {
    .status-strip > div, .problem-cards, .roles-grid { grid-template-columns: 1fr; }
    .status-strip > div { gap: 0.4rem; }
    .problem-cards article { min-height: 18rem; }
    .product-status dl div { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
