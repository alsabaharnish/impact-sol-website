---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import StatusPanel from '../../components/pages/StatusPanel.astro';
import InquiryForm from '../../components/pages/InquiryForm.astro';
import FaqList from '../../components/pages/FaqList.astro';
import { getFaqs } from '../../content/read';

const breadcrumbs = [
  { name: 'Get involved', path: '/get-involved/' },
  { name: 'Register maker or initiative interest', path: '/get-involved/maker/' },
];
const faqs = await getFaqs('products');
---

<BaseLayout
  title="Register maker or initiative interest"
  description="Tell Impact Sol. what you make or organise, your stage and location, the primary challenge, support sought, and whether your interest relates to Chokro."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs
    items={[{ label: 'Get involved', href: '/get-involved/' }, { label: 'Maker interest' }]}
  />
  <PageHero
    eyebrow="Makers and initiatives"
    title="Register your interest."
    intro="For eco-conscious makers, small sellers and purpose-led initiatives — including anyone who wants to register interest in the Chokro prototype."
  >
    <div slot="aside">
      <StatusPanel
        title="What registering interest means"
        text="It records your perspective and lets us contact you. It does not create a place on a waiting list, seller approval, or access to Chokro, which is not publicly available."
      />
    </div>
  </PageHero>

  {/* Keeps a #chokro-interest deep link resolving on this page. The form
      inside carries its own accessible name. */}
  <section class="section section--tint" id="chokro-interest" tabindex="-1">
    <div class="shell">
      <InquiryForm
        inquiryType="maker"
        title="Register maker or initiative interest"
        intro="Tell us what you make or organise, your stage and location, the primary challenge, support sought, and whether your interest relates to Chokro."
        messageLabel="Your work and perspective"
        submitLabel="Register interest"
        includeOrganisation
        includePhone
        includeCountry
        includeWebsite
      />
    </div>
  </section>

  <section class="section" aria-labelledby="other-routes-title">
    <div class="shell">
      <div class="reading-width">
        <h2 id="other-routes-title">Not the right route?</h2>
        <ul class="link-list">
          <li>
            <a href="/get-involved/partnership/">
              <span>
                <strong>Propose a partnership</strong>
                <span class="link-list__note">
                  For organisations, funders, public bodies and CSR teams
                </span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/products/chokro/">
              <span>
                <strong>Read about Chokro first</strong>
                <span class="link-list__note">
                  What the prototype does today, and what it does not claim
                </span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="/get-involved/">
              <span>
                <strong>See all pathways</strong>
                <span class="link-list__note">Compare the routes by role before choosing</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section--bordered">
      <div class="shell"><FaqList title="Before you get in touch" items={faqs} /></div>
    </section>
  )}
</BaseLayout>
