---
import Wordmark from './Wordmark.astro';
import { primaryNavigation } from '../data/site';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand-link" href="/" aria-label="Impact Sol. home">
      <Wordmark />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          primaryNavigation.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="button button--small header-cta" href="/get-involved/">Work with us</a>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span aria-hidden="true" class="mobile-nav__lines"></span>
        <span>Menu</span>
      </summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {
            primaryNavigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span>{item.label}</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M7.5 4.5l6 5.5-6 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            ))
          }
          <li><a class="button" href="/get-involved/">Work with us</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 76%, transparent);
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: grid;
    min-height: 4.75rem;
    align-items: center;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-5);
  }

  .brand-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  .desktop-nav {
    justify-self: center;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: clamp(0.15rem, 0.1rem + 0.75vw, 1.1rem);
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    padding: 0.6rem 0.6rem;
    align-items: center;
    border-radius: var(--radius-sm);
    color: var(--color-ink-soft);
    font-size: 0.91rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .desktop-nav a:hover {
    color: var(--color-forest);
    background: var(--color-mint-soft);
  }

  .desktop-nav a[aria-current='page'] {
    color: var(--color-forest);
    font-weight: var(--weight-bold);
  }

  .desktop-nav a[aria-current='page']::after {
    position: absolute;
    right: 0.6rem;
    bottom: 0.28rem;
    left: 0.6rem;
    height: 2px;
    background: var(--color-forest);
    border-radius: 2px;
    content: '';
  }

  .mobile-nav {
    display: none;
    justify-self: end;
  }

  .mobile-nav summary {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-ink);
    cursor: pointer;
    font-weight: var(--weight-bold);
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__lines,
  .mobile-nav__lines::before,
  .mobile-nav__lines::after {
    display: block;
    width: 1.2rem;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
    content: '';
  }

  .mobile-nav__lines {
    position: relative;
  }

  .mobile-nav__lines::before {
    position: absolute;
    top: -0.38rem;
  }

  .mobile-nav__lines::after {
    position: absolute;
    top: 0.38rem;
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    left: 0;
    max-height: calc(100dvh - 5.5rem);
    padding: var(--space-4) var(--gutter) var(--space-5);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-paper);
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav[open] nav {
    animation: mobile-nav-in var(--duration-base) var(--ease-out);
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .mobile-nav ul {
    align-items: stretch;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-nav li,
  .mobile-nav a {
    width: 100%;
  }

  .mobile-nav a:not(.button) {
    display: flex;
    min-height: 48px;
    padding: 0.72rem 0.25rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .mobile-nav a:not(.button):hover {
    background: var(--color-mint-soft);
  }

  .mobile-nav a svg {
    flex: 0 0 auto;
    color: var(--color-muted);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--color-forest);
    font-weight: var(--weight-bold);
  }

  .mobile-nav li:last-child a.button {
    margin-top: var(--space-4);
  }

  @media (max-width: 68rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto auto;
      gap: var(--space-4);
    }

    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 26rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .header-cta {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-paper);
      backdrop-filter: none;
    }
  }
</style>
