---
import Wordmark from './Wordmark.astro';
import { primaryNavigation } from '../data/site';

const pathname = Astro.url.pathname;

/** Exact match: marks the one page the visitor is on. */
const isPage = (href: string) => (href === '/' ? pathname === href : pathname === href);

/** Ancestor match: marks the top-level item whose section the visitor is in. */
const isSection = (href: string) =>
  href === '/' ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand-link" href="/" aria-label="Impact Sol. home">
      <Wordmark />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          primaryNavigation.map((item) =>
            item.children ? (
              <li class="nav-group" data-nav-group>
                {/* The label stays a link so the section is one click away, and
                    the chevron is a separate control so keyboard and touch
                    users get the submenu without depending on hover. */}
                <a
                  href={item.href}
                  aria-current={isPage(item.href) ? 'page' : undefined}
                  data-nav-section={isSection(item.href) ? 'true' : undefined}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="nav-group__toggle"
                  aria-expanded="false"
                  aria-controls={`nav-menu-${item.label.toLowerCase().replace(/\W+/g, '-')}`}
                  data-nav-toggle
                >
                  <span class="visually-hidden">{`${item.label} sections`}</span>
                  <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
                    <path
                      d="M5 8l5 5 5-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <ul
                  class="nav-menu"
                  id={`nav-menu-${item.label.toLowerCase().replace(/\W+/g, '-')}`}
                  data-nav-menu
                >
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isPage(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isPage(item.href) ? 'page' : undefined}
                  data-nav-section={isSection(item.href) ? 'true' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a class="button button--small header-cta" href="/get-involved/">Work with us</a>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span aria-hidden="true" class="mobile-nav__lines"></span>
        <span>Menu</span>
      </summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {
            primaryNavigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isPage(item.href) ? 'page' : undefined}>
                  <span>{item.label}</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M7.5 4.5l6 5.5-6 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                {item.children && (
                  <ul class="mobile-nav__sub">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          aria-current={isPage(child.href) ? 'page' : undefined}
                        >
                          <span>{child.label}</span>
                          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
                            <path d="M7.5 4.5l6 5.5-6 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
          <li><a class="button" href="/get-involved/">Work with us</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 76%, transparent);
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: grid;
    min-height: 4.75rem;
    align-items: center;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-5);
  }

  .brand-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  .desktop-nav {
    justify-self: center;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: clamp(0.15rem, 0.1rem + 0.75vw, 1.1rem);
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    padding: 0.6rem 0.6rem;
    align-items: center;
    border-radius: var(--radius-sm);
    color: var(--color-ink-soft);
    font-size: 0.91rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .desktop-nav a:hover {
    color: var(--color-forest);
    background: var(--color-mint-soft);
  }

  .desktop-nav a[aria-current='page'],
  .desktop-nav a[data-nav-section='true'] {
    color: var(--color-forest);
    font-weight: var(--weight-bold);
  }

  /* Solid rule marks the exact page; a lighter rule marks the section the
     visitor is inside, so a child page still shows where it belongs. */
  .desktop-nav a[aria-current='page']::after,
  .desktop-nav a[data-nav-section='true']::after {
    position: absolute;
    right: 0.6rem;
    bottom: 0.28rem;
    left: 0.6rem;
    height: 2px;
    background: var(--color-forest);
    border-radius: 2px;
    content: '';
  }

  .desktop-nav a[data-nav-section='true']:not([aria-current='page'])::after {
    background: color-mix(in srgb, var(--color-forest) 32%, transparent);
  }

  /* ------------------------------ Dropdown ------------------------------ */

  .nav-group {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .nav-group > a {
    padding-right: 0.15rem;
  }

  .nav-group > a[aria-current='page']::after,
  .nav-group > a[data-nav-section='true']::after {
    right: 0.15rem;
  }

  .nav-group__toggle {
    display: inline-grid;
    width: 1.9rem;
    min-height: 44px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-ink-soft);
    background: none;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav-group__toggle svg {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-group__toggle:hover {
    color: var(--color-forest);
    background: var(--color-mint-soft);
  }

  .nav-group[data-open='true'] .nav-group__toggle {
    color: var(--color-forest);
  }

  .nav-group[data-open='true'] .nav-group__toggle svg {
    transform: rotate(-180deg);
  }

  .nav-menu {
    position: absolute;
    z-index: 60;
    top: 100%;
    left: -0.35rem;
    display: grid;
    width: max-content;
    min-width: 14rem;
    max-width: min(22rem, calc(100vw - 2rem));
    margin: 0;
    padding: 0.4rem;
    align-items: stretch;
    flex-direction: column;
    gap: 0.1rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(-0.35rem);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility var(--duration-fast);
    visibility: hidden;
  }

  .nav-group[data-open='true'] .nav-menu {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }

  .nav-menu li {
    width: 100%;
  }

  .nav-menu a {
    display: block;
    width: 100%;
    min-height: 40px;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: normal;
  }

  .nav-menu a::after {
    content: none;
  }

  .nav-menu a:hover {
    background: var(--color-mint-soft);
    color: var(--color-forest);
  }

  .nav-menu a[aria-current='page'] {
    color: var(--color-forest);
    background: var(--color-mint-soft);
    font-weight: var(--weight-bold);
  }

  /* Hover is handled in site.js rather than with :hover, so `data-open` is the
     single source of truth. A CSS hover rule could hold the panel open while
     aria-expanded said "false" — a mismatch for anyone using a screen reader
     with a mouse, and it made the chevron unable to close a hovered menu. */

  /* Bridges the gap between the label and the panel so crossing it with the
     mouse does not count as leaving the group. */
  @media (hover: hover) and (pointer: fine) {
    .nav-group::after {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      height: 0.5rem;
      content: '';
    }
  }

  .mobile-nav {
    display: none;
    justify-self: end;
  }

  .mobile-nav summary {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-ink);
    cursor: pointer;
    font-weight: var(--weight-bold);
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__lines,
  .mobile-nav__lines::before,
  .mobile-nav__lines::after {
    display: block;
    width: 1.2rem;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
    content: '';
  }

  .mobile-nav__lines {
    position: relative;
  }

  .mobile-nav__lines::before {
    position: absolute;
    top: -0.38rem;
  }

  .mobile-nav__lines::after {
    position: absolute;
    top: 0.38rem;
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    left: 0;
    max-height: calc(100dvh - 5.5rem);
    padding: var(--space-4) var(--gutter) var(--space-5);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-paper);
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav[open] nav {
    animation: mobile-nav-in var(--duration-base) var(--ease-out);
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .mobile-nav ul {
    align-items: stretch;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-nav li,
  .mobile-nav a {
    width: 100%;
  }

  .mobile-nav a:not(.button) {
    display: flex;
    min-height: 48px;
    padding: 0.72rem 0.25rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .mobile-nav a:not(.button):hover {
    background: var(--color-mint-soft);
  }

  .mobile-nav a svg {
    flex: 0 0 auto;
    color: var(--color-muted);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--color-forest);
    font-weight: var(--weight-bold);
  }

  .mobile-nav li:last-child a.button {
    margin-top: var(--space-4);
  }

  /* No hover on touch, and the panel already scrolls, so children are simply
     shown indented rather than hidden behind another tap. */
  .mobile-nav__sub {
    margin: 0;
    padding: 0 0 0 var(--space-4);
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    list-style: none;
  }

  .mobile-nav__sub a {
    min-height: 44px !important;
    color: var(--color-ink-soft) !important;
    font-size: 0.92rem;
    font-weight: var(--weight-medium) !important;
  }

  .mobile-nav__sub li:last-child a {
    border-bottom: 0;
  }

  @media (max-width: 68rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto auto;
      gap: var(--space-4);
    }

    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 26rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .header-cta {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-paper);
      backdrop-filter: none;
    }
  }
</style>
