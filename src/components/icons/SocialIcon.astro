---
interface Props {
  url: string;
}

type Platform =
  | 'facebook'
  | 'github'
  | 'instagram'
  | 'linkedin'
  | 'medium'
  | 'threads'
  | 'tiktok'
  | 'whatsapp'
  | 'x'
  | 'youtube'
  | 'website';

const { url } = Astro.props;

let hostname = '';
try {
  hostname = new URL(url).hostname.toLowerCase().replace(/^www\./, '');
} catch {
  /* Content validation reports malformed URLs; the generic icon remains safe. */
}

const isHost = (domain: string) => hostname === domain || hostname.endsWith(`.${domain}`);

const platformOf = (): Platform => {
  if (isHost('linkedin.com')) return 'linkedin';
  if (isHost('facebook.com') || isHost('fb.com')) return 'facebook';
  if (isHost('instagram.com')) return 'instagram';
  if (isHost('x.com') || isHost('twitter.com')) return 'x';
  if (isHost('youtube.com') || isHost('youtu.be')) return 'youtube';
  if (isHost('github.com')) return 'github';
  if (isHost('tiktok.com')) return 'tiktok';
  if (isHost('whatsapp.com') || isHost('wa.me')) return 'whatsapp';
  if (isHost('threads.net')) return 'threads';
  if (isHost('medium.com')) return 'medium';
  return 'website';
};

const platform = platformOf();
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {platform === 'linkedin' ? (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="3"></rect>
      <path d="M8 10.5V17M8 7.5v.01M12 17v-3.7a2.8 2.8 0 0 1 5.6 0V17M12 10.5V17"></path>
    </g>
  ) : platform === 'facebook' ? (
    <g>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M13.4 20v-7h2.7l.4-3h-3.1V8.5c0-1 .4-1.6 1.7-1.6h1.7V4.3c-.7-.1-1.4-.2-2.2-.2-2.5 0-4.1 1.5-4.1 4.2V10H8v3h2.5v7"></path>
    </g>
  ) : platform === 'instagram' ? (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.4" cy="6.7" r=".8" fill="currentColor" stroke="none"></circle>
    </g>
  ) : platform === 'x' ? (
    <path d="M5 4l14 16M19 4 5 20"></path>
  ) : platform === 'youtube' ? (
    <g>
      <rect x="3" y="6" width="18" height="12" rx="4"></rect>
      <path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none"></path>
    </g>
  ) : platform === 'github' ? (
    <g>
      <path d="M15 21v-3.5c0-1 .1-1.5-.5-2 3-.3 6-1.5 6-6.4 0-1.4-.5-2.6-1.3-3.5.1-.4.6-1.8-.1-3.6 0 0-1.1-.4-3.7 1.3a12.8 12.8 0 0 0-6.8 0C6 1.6 4.9 2 4.9 2c-.7 1.8-.2 3.2-.1 3.6A5 5 0 0 0 3.5 9c0 4.9 3 6.1 6 6.4-.5.5-.8 1.1-.9 1.8"></path>
      <path d="M9 19c-3.5 1.6-4-1.8-5.5-2.2M9 21v-4"></path>
    </g>
  ) : platform === 'tiktok' ? (
    <g>
      <path d="M15 4v10.4a4.4 4.4 0 1 1-4-4.4"></path>
      <path d="M15 4c.5 2.3 2 3.7 4 4"></path>
    </g>
  ) : platform === 'whatsapp' ? (
    <g>
      <path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.6Z"></path>
      <path d="M9 8.3c.4 2.7 2 4.3 4.7 4.7l1.2-1.2 2.1 1v1.5c0 .8-.7 1.5-1.5 1.5A7.3 7.3 0 0 1 8.2 8.5C8.2 7.7 8.9 7 9.7 7h1.5l1 2.1-1.2 1.2"></path>
    </g>
  ) : platform === 'threads' ? (
    <g>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M15.8 8.7c-.8-1.2-2-1.8-3.8-1.8-2.8 0-4.7 2-4.7 5.1s1.9 5.1 4.8 5.1c2.7 0 4.6-1.5 4.6-3.7 0-1.7-1.3-2.9-3.2-2.9-1.8 0-3.1.9-3.1 2.2 0 1 .8 1.7 2 1.7 2.3 0 3.8-1.8 3.8-4.4v-.4"></path>
    </g>
  ) : platform === 'medium' ? (
    <g>
      <path d="M4 7h3l5 10 5-10h3M6 7v10M18 7v10"></path>
    </g>
  ) : (
    <g>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
    </g>
  )}
</svg>

<style>
  .social-icon {
    width: 1.45rem;
    height: 1.45rem;
    flex: none;
  }
</style>
