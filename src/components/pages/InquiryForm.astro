---
type InquiryType = 'general' | 'partnership' | 'maker';

interface Props {
  inquiryType: InquiryType;
  title: string;
  intro: string;
  messageLabel?: string;
  submitLabel?: string;
  includePhone?: boolean;
  includeOrganisation?: boolean;
  includeCountry?: boolean;
  includeWebsite?: boolean;
}

const {
  inquiryType,
  title,
  intro,
  messageLabel = 'How can we help?',
  submitLabel = 'Send message',
  includePhone = false,
  includeOrganisation = false,
  includeCountry = false,
  includeWebsite = false,
} = Astro.props;

const prefix = `inquiry-${inquiryType}`;
const organisationField = inquiryType === 'maker' ? 'initiativeName' : 'organization';
const organisationLabel = inquiryType === 'maker' ? 'Business or initiative name' : 'Organisation';
const detailedRoute = inquiryType === 'partnership' || inquiryType === 'maker';
const formName = `impact-sol-${inquiryType}`;
---

<section class="inquiry-panel" aria-labelledby={`${prefix}-title`}>
  <div class="inquiry-panel__intro">
    <h2 id={`${prefix}-title`}>{title}</h2>
    <p>{intro}</p>
    <p class="form-note">Fields marked <span class="required-mark" aria-hidden="true">*</span> are required.</p>
  </div>

  <form
    class="inquiry-form"
    name={formName}
    action="/thank-you/"
    method="post"
    data-netlify="true"
    data-netlify-honeypot="companyWebsite"
    data-inquiry-form={inquiryType}
  >
    <input type="hidden" name="form-name" value={formName} />
    <input type="hidden" name="inquiryType" value={inquiryType} />
    <input type="hidden" name="sourcePath" value={Astro.url.pathname} />

    <div class="honeypot" aria-hidden="true">
      <label for={`${prefix}-company-website`}>Leave this field blank</label>
      <input
        id={`${prefix}-company-website`}
        name="companyWebsite"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="form-grid">
      {inquiryType === 'general' && (
        <div class="field">
          <label for={`${prefix}-subject`}>Inquiry category <span class="required-mark" aria-hidden="true">*</span></label>
          <select id={`${prefix}-subject`} name="subject" required aria-describedby={`${prefix}-subject-error`}>
            <option value="">Choose a category</option>
            <option value="General question">General question</option>
            <option value="Website feedback">Website feedback</option>
            <option value="Accessibility feedback">Accessibility feedback</option>
            <option value="Media enquiry">Media enquiry</option>
            <option value="Privacy request">Privacy request</option>
          </select>
          <p class="field-error" id={`${prefix}-subject-error`} data-error-for="subject"></p>
        </div>
      )}

      <div class="field">
        <label for={`${prefix}-name`}>Name <span class="required-mark" aria-hidden="true">*</span></label>
        <input
          id={`${prefix}-name`}
          name="name"
          type="text"
          autocomplete="name"
          minlength="2"
          maxlength="100"
          required
          aria-describedby={`${prefix}-name-error`}
        />
        <p class="field-error" id={`${prefix}-name-error`} data-error-for="name"></p>
      </div>

      <div class="field">
        <label for={`${prefix}-email`}>Email <span class="required-mark" aria-hidden="true">*</span></label>
        <input
          id={`${prefix}-email`}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby={`${prefix}-email-error`}
        />
        <p class="field-error" id={`${prefix}-email-error`} data-error-for="email"></p>
      </div>

      {includeOrganisation && (
        <div class="field">
          <label for={`${prefix}-organisation`}>{organisationLabel} {detailedRoute ? <span class="required-mark" aria-hidden="true">*</span> : <span class="optional-mark">optional</span>}</label>
          <input
            id={`${prefix}-organisation`}
            name={organisationField}
            type="text"
            autocomplete="organization"
            maxlength="160"
            required={detailedRoute}
            aria-describedby={`${prefix}-${organisationField}-error`}
          />
          <p class="field-error" id={`${prefix}-${organisationField}-error`} data-error-for={organisationField}></p>
        </div>
      )}

      {includePhone && (
        <div class="field">
          <label for={`${prefix}-phone`}>Phone <span class="optional-mark">optional</span></label>
          <input
            id={`${prefix}-phone`}
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            maxlength="32"
            aria-describedby={`${prefix}-phone-error`}
          />
          <p class="field-error" id={`${prefix}-phone-error`} data-error-for="phone"></p>
        </div>
      )}

      {includeCountry && (
        <div class="field">
          <label for={`${prefix}-country`}>Country or region {detailedRoute ? <span class="required-mark" aria-hidden="true">*</span> : <span class="optional-mark">optional</span>}</label>
          <input
            id={`${prefix}-country`}
            name="country"
            type="text"
            autocomplete="country-name"
            maxlength="80"
            required={detailedRoute}
            aria-describedby={`${prefix}-country-error`}
          />
          <p class="field-error" id={`${prefix}-country-error`} data-error-for="country"></p>
        </div>
      )}

      {includeWebsite && (
        <div class="field">
          <label for={`${prefix}-website-url`}>Website or public profile <span class="optional-mark">optional</span></label>
          <input
            id={`${prefix}-website-url`}
            name="websiteUrl"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="https://"
            maxlength="300"
            aria-describedby={`${prefix}-website-url-error`}
          />
          <p class="field-error" id={`${prefix}-website-url-error`} data-error-for="websiteUrl"></p>
        </div>
      )}

      {inquiryType === 'partnership' && (
        <>
          <div class="field">
            <label for={`${prefix}-role`}>Your role or organisation type <span class="required-mark" aria-hidden="true">*</span></label>
            <input id={`${prefix}-role`} name="role" type="text" maxlength="100" required />
          </div>
          <div class="field">
            <label for={`${prefix}-interest`}>Proposed collaboration <span class="required-mark" aria-hidden="true">*</span></label>
            <input id={`${prefix}-interest`} name="partnershipInterest" type="text" maxlength="300" required />
          </div>
        </>
      )}

      {inquiryType === 'maker' && (
        <>
          <div class="field">
            <label for={`${prefix}-role`}>Type of work <span class="required-mark" aria-hidden="true">*</span></label>
            <input id={`${prefix}-role`} name="role" type="text" maxlength="100" required />
          </div>
          <div class="field">
            <label for={`${prefix}-stage`}>Current stage <span class="required-mark" aria-hidden="true">*</span></label>
            <select id={`${prefix}-stage`} name="initiativeStage" required>
              <option value="">Choose a stage</option>
              <option value="idea">Idea</option>
              <option value="testing">Testing</option>
              <option value="active">Active</option>
              <option value="scaling">Growing or scaling</option>
              <option value="other">Another stage</option>
            </select>
          </div>
          <div class="field field--full">
            <label for={`${prefix}-support`}>Primary challenge or support sought <span class="required-mark" aria-hidden="true">*</span></label>
            <textarea id={`${prefix}-support`} name="supportNeeded" rows="3" maxlength="500" required></textarea>
          </div>
        </>
      )}
    </div>

    <div class="field">
      <label for={`${prefix}-message`}>{messageLabel} <span class="required-mark" aria-hidden="true">*</span></label>
      <textarea
        id={`${prefix}-message`}
        name="message"
        rows="7"
        minlength="20"
        maxlength="3000"
        required
        aria-describedby={`${prefix}-message-hint ${prefix}-message-error`}
    ></textarea>
      <p class="field-hint" id={`${prefix}-message-hint`}>Please include enough context for us to understand your enquiry. Do not include sensitive personal information.</p>
      <p class="field-error" id={`${prefix}-message-error`} data-error-for="message"></p>
    </div>

    <p class="privacy-note">
      We use the information you submit to receive, route and respond to your enquiry. Read the <a href="/privacy/">draft privacy notice</a> for details. Please do not include sensitive personal information.
    </p>
    <input type="hidden" name="privacyNoticeVersion" value="2026-09-09-draft" />

    <div class="form-actions">
      <button class="button" type="submit" data-submit-label={submitLabel}>{submitLabel}</button>
      <p class="form-status" role="status" aria-live="polite" aria-atomic="true" data-form-status></p>
    </div>

    <noscript>
      <p class="form-note">JavaScript is not required to submit this form. After a successful submission, your browser will open a confirmation page.</p>
    </noscript>
  </form>
</section>

<style>
  .inquiry-panel {
    display: grid;
    grid-template-columns: minmax(14rem, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  /* Sticks only while the form is actually taller than the viewport, so a
     short column no longer leaves a tall dead zone beneath itself. */
  .inquiry-panel__intro {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .inquiry-panel__intro h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-3);
  }

  .inquiry-panel__intro > p {
    max-width: 32ch;
    color: var(--color-ink-soft);
  }

  /* One elevation source. The panel floats; it does not also draw a border. */
  .inquiry-form {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.35rem, 4vw, 2.5rem);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-4);
  }

  .field {
    display: grid;
    gap: 0.42rem;
    min-width: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field label {
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-snug);
  }

  .required-mark {
    margin-left: 0.1em;
    color: var(--color-error);
    font-weight: var(--weight-bold);
  }

  /* "optional" reads as a quiet chip rather than parenthetical noise. */
  .optional-mark {
    margin-left: 0.35em;
    padding: 0.05rem 0.34rem;
    color: var(--color-muted);
    background: var(--color-paper-muted);
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    text-transform: lowercase;
    vertical-align: 0.06em;
  }

  .field-hint,
  .form-note,
  .form-status {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
  }

  /* Every control shares one surface, border and radius. Selects are drawn
     rather than left native, which on macOS ignored the background entirely
     and rendered white beside cream inputs. */
  .field input:not([type='checkbox']),
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.72rem 0.85rem;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 2px rgb(16 32 28 / 5%) inset;
    font: inherit;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .field select {
    padding-right: 2.6rem;
    background-image: var(--icon-chevron);
    background-repeat: no-repeat;
    background-position: right 0.85rem center;
    background-size: 1.15rem;
    appearance: none;
  }

  .field :is(input, select, textarea):hover:not(:disabled) {
    border-color: var(--color-line-hover);
  }

  .field textarea {
    min-height: 10rem;
    line-height: var(--leading-body);
    resize: vertical;
  }

  .field :is(input, select, textarea):focus-visible {
    border-color: var(--color-forest);
    outline: 3px solid var(--color-forest);
    outline-offset: 2px;
    box-shadow: 0 0 0 1px var(--color-sun-soft);
  }

  .field :is(input, select, textarea):disabled {
    color: var(--color-muted);
    background-color: var(--color-paper-muted);
    box-shadow: none;
    cursor: not-allowed;
  }

  /* Invalid state carries a 2px border and a tinted field, so it survives
     grayscale and high-contrast rather than relying on hue alone. */
  .field [aria-invalid='true'] {
    border-color: var(--color-error);
    border-width: 2px;
    background-color: var(--color-error-surface);
  }

  .field-error {
    min-height: 1.25em;
    margin: 0;
    color: var(--color-error);
    font-size: 0.85rem;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .field-hint {
    margin: 0;
  }

  .privacy-note {
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    background: var(--color-paper);
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    line-height: var(--leading-snug);
  }

  .form-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .form-status {
    margin: 0;
  }

  .form-status:not(:empty) {
    flex: 1 1 15rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-semibold);
  }

  .form-status[data-state='success'] {
    border-color: var(--color-success-line);
    color: var(--color-success);
    background: var(--color-success-surface);
  }

  .form-status[data-state='error'] {
    border-color: var(--color-error-line);
    color: var(--color-error);
    background: var(--color-error-surface);
  }

  .honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
  }

  @media (max-width: 62rem) {
    .inquiry-panel {
      grid-template-columns: 1fr;
    }

    .inquiry-panel__intro {
      position: static;
    }

    .inquiry-panel__intro > p {
      max-width: 60ch;
    }
  }

  @media (max-width: 40rem) {
    .form-grid {
      grid-template-columns: 1fr;
    }

    .field--full {
      grid-column: auto;
    }
  }
</style>
