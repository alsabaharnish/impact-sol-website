---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  compact?: boolean;
}

const { eyebrow, title, intro, compact = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', { 'page-hero--compact': compact }]}>
  <div class:list={['shell', 'page-hero__inner', { 'page-hero__inner--single': !hasAside }]}>
    <div class="page-hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <slot />
    </div>
    {hasAside && (
      <div class="page-hero__aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: clip;
    padding: clamp(3.25rem, 6.5vw, 6rem) 0 clamp(3.75rem, 7vw, 6.5rem);
    background:
      radial-gradient(circle at 88% 12%, color-mix(in srgb, var(--color-sun-soft) 28%, transparent), transparent 24rem),
      linear-gradient(145deg, var(--color-paper) 62%, color-mix(in srgb, var(--color-mint-soft) 76%, var(--color-paper)));
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 68%, transparent);
  }

  .page-hero::after {
    position: absolute;
    right: max(var(--gutter), calc((100vw - var(--shell)) / 2));
    bottom: 0;
    width: clamp(5rem, 11vw, 9rem);
    height: 3px;
    background: linear-gradient(90deg, var(--color-sun), transparent);
    content: '';
  }

  .page-hero--compact {
    padding-block: clamp(2.6rem, 5vw, 4.25rem);
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
  }

  .page-hero__copy {
    max-width: 50rem;
  }

  .page-hero__inner--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .page-hero h1 {
    max-width: var(--measure-display);
    margin: 0;
    font-size: var(--step-5);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-wrap: balance;
  }

  .page-hero .lead {
    max-width: 44rem;
    margin-top: var(--space-4);
  }

  @media (max-width: 50rem) {
    .page-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
