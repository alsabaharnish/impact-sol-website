---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  compact?: boolean;
}

const { eyebrow, title, intro, compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--compact': compact }]}> 
  <div class="shell page-hero__inner">
    <div class="page-hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <slot />
    </div>
    <div class="page-hero__aside" aria-hidden={!Astro.slots.has('aside')}>
      <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: clip;
    padding: clamp(3.5rem, 8vw, 8rem) 0 clamp(4rem, 8vw, 7.5rem);
    background:
      radial-gradient(circle at 88% 10%, color-mix(in srgb, var(--color-sun) 18%, transparent) 0 7%, transparent 32%),
      linear-gradient(150deg, var(--color-paper) 58%, var(--color-mint-soft));
  }

  .page-hero::after {
    position: absolute;
    right: -9rem;
    bottom: -16rem;
    width: 34rem;
    height: 34rem;
    border: 1px solid color-mix(in srgb, var(--color-forest) 15%, transparent);
    border-radius: 50%;
    content: '';
  }

  .page-hero--compact {
    padding-block: clamp(2.8rem, 6vw, 5rem);
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
  }

  .page-hero__copy {
    max-width: 52rem;
  }

  .page-hero h1 {
    max-width: 13ch;
    margin: 0;
    font-size: var(--step-6);
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .page-hero .lead {
    max-width: 44rem;
    margin-top: var(--space-5);
  }

  .page-hero__aside:empty {
    display: none;
  }

  @media (max-width: 50rem) {
    .page-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
