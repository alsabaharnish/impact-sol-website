---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  href: string;
  label: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { eyebrow, title, text, href, label, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="cta-band">
  <div class="shell cta-band__inner">
    <div>
      {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="button-row">
      <a class="button button--sun" href={href}>{label}</a>
      {secondaryHref && secondaryLabel && <a class="text-link text-link--light" href={secondaryHref}>{secondaryLabel}<span aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: clamp(3rem, 7vw, 6rem) 0;
    color: var(--color-paper);
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--color-teal) 75%, transparent), transparent 38%),
      var(--color-forest);
  }

  .cta-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    align-items: end;
    gap: clamp(2rem, 7vw, 8rem);
  }

  h2 {
    max-width: 18ch;
    margin: 0;
    color: inherit;
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    line-height: 1.03;
    text-wrap: balance;
  }

  p:not(.eyebrow) {
    max-width: 44rem;
    margin-top: var(--space-4);
    color: var(--color-paper-muted);
  }

  .button-row {
    justify-content: flex-end;
  }

  @media (max-width: 44rem) {
    .cta-band__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .button-row {
      justify-content: flex-start;
    }
  }
</style>
